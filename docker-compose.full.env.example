# Plantilla de variables de docker-compose.full.yml (Etapa 13). Copiar a docker-compose.full.env y completar.
# docker-compose.full.env NO se versiona (agregado a .gitignore). Ningun valor de este archivo es un secreto real.

# Base de datos (usuario postgres del contenedor).
POSTGRES_PASSWORD=

# GymBro.Api. JWT_KEY: al menos 32 caracteres aleatorios.
JWT_KEY=
# Clave del QR de asistencia: al menos 32 caracteres; vacia = QR deshabilitado (el registro manual sigue disponible).
ASISTENCIA_CLAVE_QR=
# Opcional: crea el Administrador de la Plataforma al arrancar.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# GymBro.IA. Con Ollama en el equipo y no en contenedor: http://host.docker.internal:11434
OLLAMA_HOST=http://ollama:11434
# PUNTO DE ESPERA 2 de la Etapa 9b-2: elegir el modelo despues de la prueba de hardware.
OLLAMA_MODELO_GENERACION=
OLLAMA_VERSION=latest

# GymBro.Analytics (roles creados con docs/pfc/scripts/rol-analitica.sql).
ANALITICA_PG_CLAVE=
ANALITICA_APP_USUARIO=
ANALITICA_APP_CLAVE=

# Puertos publicados.
PUERTO_WEB=8080
PUERTO_ANALITICA=8501
